<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaViewer.App.ConversionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="変換 - メディアビューワー">

    <Grid Background="#FF161616" Padding="24,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 入力ファイル -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="入力ファイル" Opacity="0.8" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" IsReadOnly="True" AutomationProperties.Name="入力ファイル" />
                <Button x:Name="BrowseInputButton" Grid.Column="1" Content="参照..." Click="OnBrowseInputClick" />
            </Grid>
        </StackPanel>

        <!-- 出力形式 -->
        <ComboBox x:Name="FormatBox"
                  Grid.Row="1"
                  Header="出力形式"
                  MinWidth="220"
                  SelectionChanged="OnFormatChanged"
                  AutomationProperties.Name="出力形式" />

        <!-- 保存先 -->
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="保存先フォルダ" Opacity="0.8" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" TextChanged="OnOutputTextChanged" AutomationProperties.Name="保存先フォルダ" />
                <Button x:Name="BrowseFolderButton" Grid.Column="1" Content="参照..." Click="OnBrowseFolderClick" />
            </Grid>
        </StackPanel>

        <TextBox x:Name="FileNameBox" Grid.Row="3" Header="ファイル名" TextChanged="OnOutputTextChanged" AutomationProperties.Name="ファイル名" />

        <!-- 変換前の確認事項（失われるもの・品質が変わるもの） -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <TextBlock x:Name="AnalyzingText" Text="ファイルを調べています..." Opacity="0.7" Visibility="Collapsed" />
                <ItemsControl x:Name="NoticeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FFFFC83D" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoLossText" Text="変換による劣化や欠落はありません（再エンコードなし）。" Opacity="0.75" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- 進捗 -->
        <StackPanel Grid.Row="5" Spacing="6">
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 操作 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="OpenFolderButton" Content="フォルダを開く" Visibility="Collapsed" Click="OnOpenFolderClick" />
            <Button x:Name="OpenResultButton" Content="ビューワーで開く" Visibility="Collapsed" Click="OnOpenResultClick" />
            <Button x:Name="StartButton" Content="変換開始" Style="{StaticResource AccentButtonStyle}" Click="OnStartClick" IsEnabled="False" />
            <Button x:Name="CancelButton" Content="キャンセル" Visibility="Collapsed" Click="OnCancelClick" />
            <Button x:Name="CloseButton" Content="閉じる" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
